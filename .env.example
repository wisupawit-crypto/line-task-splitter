# ── LINE Messaging API ──────────────────────────────────
# LINE Developers Console → Channel ของคุณ → Basic settings / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Supabase ────────────────────────────────────────────
# Project Settings → API
# ⚠️ ใช้ service_role key เท่านั้น และใช้เฉพาะฝั่ง server
#    ห้ามเอาไปไว้ในโค้ดฝั่งเบราว์เซอร์เด็ดขาด (มันข้าม RLS ได้ทั้งหมด)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM: ชั้นสะกิดถาม ───────────────────────────────────
# ถ้าเว้นว่างไว้ บอทจะทำงานเฉพาะโหมดคำสั่ง /งาน (ไม่สะกิดถาม)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ── Cron ────────────────────────────────────────────────
# ตั้งค่าอะไรก็ได้ที่เดายาก ใช้กันคนนอกยิง /api/daily-digest เล่น
CRON_SECRET=
